{
  "expo": {
    "name": "Eziel",
    "slug": "eziel-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "eziel",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.eziel.marketplace",
      "buildNumber": "1",
      "icon": "./assets/expo.icon",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "com.eziel.marketplace",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F97316",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Eziel necesita acceso a tus fotos para que puedas agregar imágenes a tus publicaciones.",
          "cameraPermission": "Eziel necesita acceso a la cámara para que puedas tomar fotos para tus publicaciones.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Eziel necesita acceder a tu ubicación mientras usás la app para ayudarte a indicar dónde se encuentra tu publicación.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "react-native-nitro-google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
